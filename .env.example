# --- Groq (FREE, recommended — vision + text) ---
# Get key: https://console.groq.com/keys  (no credit card)
GROQ_API_KEY=your_groq_api_key_here
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
GROQ_TEXT_MODEL=llama-3.3-70b-versatile

# Provider order: groq → gemini → rules fallback
LLM_PROVIDER_CHAIN=groq,gemini,rules

# --- Google Gemini (optional fallback) ---
# Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_FALLBACKS=gemini-2.5-flash,gemini-2.0-flash-lite,gemini-2.0-flash

# Frontend (optional — defaults to http://localhost:8000)
VITE_API_URL=http://localhost:8000
